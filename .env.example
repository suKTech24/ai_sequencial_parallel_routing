# Copy to .env and fill in. Never commit .env.

# fixtures (default, offline, no keys needed) | live
PROVIDER_MODE=fixtures

# Required only when PROVIDER_MODE=live
VIRUSTOTAL_API_KEY=
ABUSECH_AUTH_KEY=

PROVIDER_TIMEOUT_SECONDS=10

# LangChain init_chat_model identifiers. Install the matching extra and set that provider's key:
#   openai:     uv sync --extra openai      LLM_PROVIDER=openai      LLM_MODEL=gpt-4o-mini         OPENAI_API_KEY=
#   openrouter: uv sync --extra openrouter  LLM_PROVIDER=openrouter  LLM_MODEL=openai/gpt-4o-mini  OPENROUTER_API_KEY=
#   anthropic:  uv sync --extra anthropic   LLM_PROVIDER=anthropic   LLM_MODEL=<model id>          ANTHROPIC_API_KEY=
# Leave LLM_MODEL blank to always use the template summary.
LLM_MODEL=
LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=20

LOG_LEVEL=INFO
